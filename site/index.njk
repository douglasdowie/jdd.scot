{% extends 'base.njk' %}

{% block canonical %}
        <link href="{{ jdd.website }}" rel="canonical">
{%- endblock %}

{% block link -%}
{% include "link.njk" %}
{%- endblock -%}

{% block robots %}
        <meta name="robots" content="index, follow">
{%- endblock %}

{% block meta %}
{% include "meta.njk" %}
{%- endblock -%}

{% block json %}
{% include "json.njk" %}
{%- endblock -%}

{% block content %}
            <article id="about">
                <h3>
                    <span aria-hidden="true">&gt;&nbsp;jdd&nbsp;--</span>
                    <span>about</span>
                </h3>
                <p>
                    Hello! I'm Douglas, a Software Engineer based in Scotland. This is my wee bit of the internet. After
                    leading my team (Nessie) to modernise all our data products, I am back building things. This website
                    started as a way to reconnect after three and a half years as an Engineering Manager but is now part
                    of working out what comes next.
                </p>
            </article>
            <nav id="links">
                <h3>
                    <span aria-hidden="true">&gt;&nbsp;jdd&nbsp;--</span>
                    <span>links</span>
                </h3>
                <section>
                    <address id="code">
                        <a href="{{ jdd.me.github }}" rel="me external noopener">Code</a>
                    </address>
                    <address id="contact">
                        <a href="{{ jdd.email }}" rel="me">Contact</a>
                    </address>
                    <address id="connect">
                        <a href="{{ jdd.me.linkedin }}" rel="me external noopener">Connect</a>
                    </address>
                </section>
            </nav>
{%- endblock %}
