{% extends 'base.njk' %}

{% block canonical %}
        <link href="{{ jdd.website }}" rel="canonical">
{%- endblock %}

{% block link -%}
{% include "link.njk" %}
{%- endblock -%}

{% block robots %}
        <meta name="robots" content="index, follow">
{%- endblock %}

{% block meta %}
{% include "meta.njk" %}
{%- endblock -%}

{% block json %}
{% include "json.njk" %}
{%- endblock -%}

{% block content %}
            <article id="about">
                <h3>
                    <span aria-hidden="true">&gt;&nbsp;jdd&nbsp;--</span>
                    <span>about</span>
                </h3>
                <p>
                    Hello! I’m Douglas, a Software Engineer based in Scotland. This is my wee bit of the internet. I
                    started the website to reconnect with building things after stepping down as an Engineering Manager.
                    This was after leading my team (Nessie) to deliver a full modernisation of all our data products.
                </p>
            </article>
            <article id="links">
                <h3>
                    <span aria-hidden="true">&gt;&nbsp;jdd&nbsp;--</span>
                    <span>links</span>
                </h3>
                <div>
                    <figure>
                        <img alt="GitHub logo" class="link" height="42" src="/images/github.svg" width="42">
                        <figcaption>
                            <a href="{{ jdd.me.github }}" rel="me external noopener" target="_blank" >
                                GitHub
                            </a>
                        </figcaption>
                    </figure>
                    <figure>
                        <img alt="Email icon" class="link" height="42" src="/images/envelope.svg" width="42">
                        <figcaption>
                            <a href="{{ jdd.email }}" rel="me">
                                Email
                            </a>
                        </figcaption>
                    </figure>
                    <figure>
                        <img alt="LinkedIn logo" class="link" height="42" src="/images/linkedin.svg" width="42">
                        <figcaption>
                            <a href="{{ jdd.me.linkedin }}" rel="me external noopener" target="_blank">
                                LinkedIn
                            </a>
                        </figcaption>
                    </figure>
                    <figure>
                        <img alt="ORCID logo" class="link" height="42" src="/images/orcid.svg" width="42">
                        <figcaption>
                            <a href="{{ jdd.me.orcid }}" rel="me external noopener" target="_blank">
                                ORCID
                            </a>
                        </figcaption>
                    </figure>
                </div>
            </article>
{%- endblock %}
