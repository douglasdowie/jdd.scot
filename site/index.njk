{% extends 'base.njk' %}

{% block canonical %}
        <link href="{{ jdd.website }}" rel="canonical">
{%- endblock %}

{% block link -%}
{% include "link.njk" %}
{%- endblock -%}

{% block robots %}
        <meta name="robots" content="index, follow">
{%- endblock %}

{% block meta %}
{% include "meta.njk" %}
{%- endblock -%}

{% block json %}
{% include "json.njk" %}
{%- endblock -%}

{% block content %}
            <article class="h-entry" id="about">
                <h3>
                    <span aria-hidden="true">&gt;&nbsp;jdd&nbsp;--</span>
                    <span class="p-name">about</span>
                </h3>
                <div class="terminal">
                    <p class="e-content">
                        Hello! I'm Douglas, a Software Engineer based in Scotland. This is my wee bit of the internet.
                        While most of my code is proprietary, please visit GitHub for what I am building in public. This
                        website is an example, with documentation sitting alongside the code. I am a generalist, but
                        with a focus on Data Engineering, Agile, and Python. Craft is the driving force in how I
                        approach software. To deliver, I also draw on my three and a half years as Nessie's Engineering
                        Manager. During my tenure, the focus was modernising our data pipelines
                        (Spark, Databricks, AWS). After completing this, returning to coding was the right career move
                        for me.
                    </p>
                    <p class="e-content">
                        You can look me up on the register run by the
                        <a href="https://www.bcs.org" rel="external noopener" target="_blank">
                            British Computer Society.
                        </a>
                        This register is about public accountability to ethical and professional standards.
                    </p>
                    <p class="e-content">
                        I am on a career break at present, but feel free to reach out.
                    </p>
                </div>
            </article>
            <article id="links">
                <h3>
                    <span aria-hidden="true">&gt;&nbsp;jdd&nbsp;--</span>
                    <span>links</span>
                </h3>
                <div>
                    <figure>
                        <img alt="GitHub logo" class="link" height="42" src="/images/github.svg" width="42">
                        <figcaption>
                            <a href="{{ jdd.me.github }}" rel="me external noopener" target="_blank" >
                                GitHub
                            </a>
                        </figcaption>
                    </figure>
                    <figure>
                        <img alt="Email icon" class="link" height="42" src="images/envelope.svg" width="42">
                        <figcaption>
                            <a href="{{ jdd.email }}" rel="me">
                                Email
                            </a>
                        </figcaption>
                    </figure>
                    <figure>
                        <img alt="LinkedIn logo" class="link" height="42" src="images/linkedin.svg" width="42">
                        <figcaption>
                            <a href="{{ jdd.me.linkedin }}" rel="me external noopener" target="_blank">
                                LinkedIn
                            </a>
                        </figcaption>
                    </figure>
                    <figure>
                        <img alt="ORCID logo" class="link" height="42" src="images/orcid.svg" width="42">
                        <figcaption>
                            <a href="{{ jdd.me.orcid }}" rel="me external noopener" target="_blank">
                                ORCID
                            </a>
                        </figcaption>
                    </figure>
                </div>
            </article>
{%- endblock %}
