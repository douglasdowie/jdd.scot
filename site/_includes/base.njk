<!DOCTYPE html>
<html lang="{{ jdd.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{{ jdd.name }} | {{ jdd.title }}</title>
        <link href="/css/jdd.css" rel="stylesheet" type="text/css">
        <link href="/images/favicon.svg" rel="icon" type="image/svg+xml">
        <link href="/humans.txt" rel="author" type="text/plain">
        {%- block canonical -%}
            {{ canonical | safe }}
        {%- endblock %}
        {%- block link -%}
            {{ link | safe }}
        {%- endblock %}
        <meta name="author" content="{{ jdd.name }}">
        <meta name="description" content="{{ jdd.description }}">
        <meta name="generator" content="{{ eleventy.generator }}">
        {%- block robots -%}
            {{ robots | safe }}
        {%- endblock %}
        {%- block meta -%}
            {{ meta | safe }}
        {%- endblock %}
        {%- block json -%}
            {{ json | safe }}
        {%- endblock %}
        <!-- Privacy-friendly analytics by Plausible -->
        <script async src="https://plausible.io/js/pa-LMbWl_IF-yHTyqKIE9xGt.js"></script>
        <script>
          window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
          plausible.init()
        </script>
    </head>
    <body>
        <header>
            <h1 id="header">
                <a aria-label="Skip to main content" href="#main" title="Skip to main content">&gt;</a>
                <a class="h-card" href="{{ jdd.website }}" rel="home">{{ jdd.name }}</a>
                <span aria-hidden="true" class="cmd">|</span>
            </h1>
            <h2>
                <span aria-hidden="true">[</span>
                {{ jdd.title }}
                <span aria-hidden="true">]</span>
            </h2>
        </header>
        <main id="main" tabindex="-1">
            {%- block content %}
                {{ content | safe }}
            {% endblock %}
        </main>
        <footer id="footer">
            <p>&copy;&nbsp;Copyright {{ jdd.name | replace(". ", ".&nbsp;") | safe }}</p>
            <p>(alongside <a href="/humans.txt" rel="author" target="_blank">humans.txt</a>)</p>
            <a href="#main" title="Skip back to main content">... and back again</a>
        </footer>
    </body>
</html>
